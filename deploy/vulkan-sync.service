[Unit]
Description=Synchronize and translate the Vulkan tutorial mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vulkan-mirror
Group=vulkan-mirror
WorkingDirectory=/opt/vulkan-tutorial
Environment=PYTHONUNBUFFERED=1
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/usr/bin/flock -w 1800 /opt/vulkan-tutorial/.local/job.lock /opt/vulkan-tutorial/.venv/bin/python scripts/sync.py --provider google --translate-limit 300 --workers 1 --delay 1
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vulkan-tutorial

